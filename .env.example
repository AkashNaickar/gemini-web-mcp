# Path to store the persistent browser profile / session cookies
USER_DATA_DIR=./.user-data-dir

# Set to true for background headless operation, false to view the browser window
HEADLESS=true

# Navigation & response timeout in milliseconds (e.g. 60000 = 60s)
TIMEOUT_MS=60000

# Optional: Path to custom Chrome executable if not using Playwright's Chromium
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
